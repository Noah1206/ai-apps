{
  "$defs": {
    "AggregateMetrics": {
      "additionalProperties": false,
      "properties": {
        "utterance_count": {
          "minimum": 0,
          "title": "Utterance Count",
          "type": "integer"
        },
        "cer": {
          "minimum": 0,
          "title": "Cer",
          "type": "number"
        },
        "dialect_preservation_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Dialect Preservation Rate",
          "type": "number"
        },
        "context_overcorrection_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Context Overcorrection Rate",
          "type": "number"
        },
        "high_confidence_wrong_count": {
          "minimum": 0,
          "title": "High Confidence Wrong Count",
          "type": "integer"
        },
        "p50_latency_ms": {
          "minimum": 0,
          "title": "P50 Latency Ms",
          "type": "number"
        },
        "p95_latency_ms": {
          "minimum": 0,
          "title": "P95 Latency Ms",
          "type": "number"
        }
      },
      "required": [
        "utterance_count",
        "cer",
        "dialect_preservation_rate",
        "context_overcorrection_rate",
        "high_confidence_wrong_count",
        "p50_latency_ms",
        "p95_latency_ms"
      ],
      "title": "AggregateMetrics",
      "type": "object"
    },
    "DialectExpressionResult": {
      "additionalProperties": false,
      "properties": {
        "surface_form": {
          "title": "Surface Form",
          "type": "string"
        },
        "normalized_forms": {
          "items": {
            "type": "string"
          },
          "title": "Normalized Forms",
          "type": "array"
        },
        "label_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "match_status": {
          "$ref": "#/$defs/DialectMatchStatus"
        },
        "matched_form": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Form"
        }
      },
      "required": [
        "surface_form",
        "normalized_forms",
        "label_status",
        "match_status"
      ],
      "title": "DialectExpressionResult",
      "type": "object"
    },
    "DialectMatchStatus": {
      "enum": [
        "preserved",
        "overcorrected",
        "missing"
      ],
      "title": "DialectMatchStatus",
      "type": "string"
    },
    "DialectPreservationMetric": {
      "additionalProperties": false,
      "properties": {
        "preservation_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Preservation Rate",
          "type": "number"
        },
        "overcorrection_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Overcorrection Rate",
          "type": "number"
        },
        "reference_expression_count": {
          "minimum": 0,
          "title": "Reference Expression Count",
          "type": "integer"
        },
        "approved_expression_count": {
          "minimum": 0,
          "title": "Approved Expression Count",
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/DialectExpressionResult"
          },
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "preservation_rate",
        "overcorrection_rate",
        "reference_expression_count",
        "approved_expression_count",
        "results"
      ],
      "title": "DialectPreservationMetric",
      "type": "object"
    },
    "FailureTypeCount": {
      "additionalProperties": false,
      "properties": {
        "failure_type": {
          "title": "Failure Type",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "failure_type",
        "count"
      ],
      "title": "FailureTypeCount",
      "type": "object"
    },
    "HumanReviewSummary": {
      "additionalProperties": false,
      "properties": {
        "reviewed_prediction_count": {
          "minimum": 0,
          "title": "Reviewed Prediction Count",
          "type": "integer"
        },
        "review_revision_count": {
          "minimum": 0,
          "title": "Review Revision Count",
          "type": "integer"
        },
        "confirmed_count": {
          "minimum": 0,
          "title": "Confirmed Count",
          "type": "integer"
        },
        "rejected_count": {
          "minimum": 0,
          "title": "Rejected Count",
          "type": "integer"
        },
        "uncertain_count": {
          "minimum": 0,
          "title": "Uncertain Count",
          "type": "integer"
        },
        "confirmed_failure_type_counts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FailureTypeCount"
          },
          "title": "Confirmed Failure Type Counts",
          "type": "array"
        },
        "confirmed_language_model_bias_count": {
          "minimum": 0,
          "title": "Confirmed Language Model Bias Count",
          "type": "integer"
        }
      },
      "required": [
        "reviewed_prediction_count",
        "review_revision_count",
        "confirmed_count",
        "rejected_count",
        "uncertain_count",
        "confirmed_language_model_bias_count"
      ],
      "title": "HumanReviewSummary",
      "type": "object"
    },
    "ModelDescriptor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "model_provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "model_family": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Family"
        },
        "decoder_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decoder Type"
        },
        "target_language": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Language"
        },
        "fine_tuned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fine Tuned"
        },
        "checkpoint_identifier": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Identifier"
        },
        "checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint"
        },
        "tokenizer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer Version"
        },
        "config_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Hash"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ModelDescriptor",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "human_reviewed",
        "approved",
        "deprecated"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "ReviewedEvaluationCase": {
      "additionalProperties": false,
      "properties": {
        "prediction_id": {
          "format": "uuid",
          "title": "Prediction Id",
          "type": "string"
        },
        "utterance_id": {
          "format": "uuid",
          "title": "Utterance Id",
          "type": "string"
        },
        "reference_surface_text": {
          "title": "Reference Surface Text",
          "type": "string"
        },
        "hypothesis_surface_text": {
          "title": "Hypothesis Surface Text",
          "type": "string"
        },
        "cer": {
          "minimum": 0,
          "title": "Cer",
          "type": "number"
        },
        "dialect": {
          "$ref": "#/$defs/DialectPreservationMetric"
        },
        "automatic_failure_candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Automatic Failure Candidates",
          "type": "array"
        },
        "review_id": {
          "format": "uuid",
          "title": "Review Id",
          "type": "string"
        },
        "review_revision_count": {
          "minimum": 1,
          "title": "Review Revision Count",
          "type": "integer"
        },
        "review_verdict": {
          "enum": [
            "confirmed",
            "rejected",
            "uncertain"
          ],
          "title": "Review Verdict",
          "type": "string"
        },
        "confirmed_failure_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Confirmed Failure Types",
          "type": "array"
        },
        "review_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Notes"
        }
      },
      "required": [
        "prediction_id",
        "utterance_id",
        "reference_surface_text",
        "hypothesis_surface_text",
        "cer",
        "dialect",
        "review_id",
        "review_revision_count",
        "review_verdict"
      ],
      "title": "ReviewedEvaluationCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "source_report_id": {
      "title": "Source Report Id",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelDescriptor"
    },
    "automatic_metrics": {
      "$ref": "#/$defs/AggregateMetrics"
    },
    "human_review": {
      "$ref": "#/$defs/HumanReviewSummary"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ReviewedEvaluationCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "gate_decision": {
      "title": "Gate Decision",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "source_report_id",
    "experiment_id",
    "benchmark_id",
    "benchmark_version",
    "created_at",
    "model",
    "automatic_metrics",
    "human_review",
    "cases",
    "gate_decision"
  ],
  "title": "HumanReviewedBaselineReport",
  "type": "object"
}
