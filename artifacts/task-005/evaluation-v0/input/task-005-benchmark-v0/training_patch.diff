+class NonFiniteLossGuard(pl.Callback):
+    """Abort the TASK-005 run as soon as a logged batch loss is non-finite."""
+
+    @staticmethod
+    def _check(outputs, stage: str):
+        if isinstance(outputs, dict):
+            values = [value for key, value in outputs.items() if 'loss' in str(key).lower()]
+        else:
+            values = [outputs]
+
+        for value in values:
+            if isinstance(value, torch.Tensor) and not torch.isfinite(value.detach()).all():
+                raise FloatingPointError(f'non-finite {stage} loss detected')
+
+    def on_train_batch_end(self, trainer, pl_module, outputs, batch, batch_idx):
+        self._check(outputs, 'training')
+
+    def on_validation_batch_end(self, trainer, pl_module, outputs, batch, batch_idx, dataloader_idx=0):
+        self._check(outputs, 'validation')
+
