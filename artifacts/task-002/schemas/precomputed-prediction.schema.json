{
  "$defs": {
    "ASRSegment": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "text",
        "start_ms",
        "end_ms",
        "confidence"
      ],
      "title": "ASRSegment",
      "type": "object"
    },
    "ModelDescriptor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "model_provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "model_family": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Family"
        },
        "decoder_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decoder Type"
        },
        "fine_tuned": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fine Tuned"
        },
        "checkpoint_identifier": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Identifier"
        },
        "checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint"
        },
        "tokenizer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer Version"
        },
        "config_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Hash"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ModelDescriptor",
      "type": "object"
    },
    "SurfaceASRResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "surface_text": {
          "title": "Surface Text",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "confidence_supported": {
          "default": true,
          "title": "Confidence Supported",
          "type": "boolean"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "model": {
          "$ref": "#/$defs/ModelDescriptor"
        },
        "segments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ASRSegment"
          },
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "surface_text",
        "latency_ms",
        "model"
      ],
      "title": "SurfaceASRResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "benchmark_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benchmark Id"
    },
    "benchmark_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benchmark Version"
    },
    "utterance_id": {
      "title": "Utterance Id",
      "type": "string"
    },
    "audio_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audio Sha256",
      "type": "string"
    },
    "device": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device"
    },
    "inference_timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inference Timestamp"
    },
    "result": {
      "$ref": "#/$defs/SurfaceASRResult"
    }
  },
  "required": [
    "experiment_id",
    "utterance_id",
    "audio_sha256",
    "result"
  ],
  "title": "PrecomputedPrediction",
  "type": "object"
}
