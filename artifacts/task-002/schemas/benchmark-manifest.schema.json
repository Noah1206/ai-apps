{
  "$defs": {
    "BenchmarkEntry": {
      "additionalProperties": false,
      "properties": {
        "utterance_id": {
          "format": "uuid",
          "title": "Utterance Id",
          "type": "string"
        },
        "speaker_id": {
          "minLength": 1,
          "title": "Speaker Id",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/DatasetSplit"
        },
        "original_audio_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Audio Sha256",
          "type": "string"
        },
        "derived_audio_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derived Audio Sha256",
          "type": "string"
        },
        "derived_audio_path": {
          "minLength": 1,
          "title": "Derived Audio Path",
          "type": "string"
        },
        "lineage_audio_sha256s": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lineage Audio Sha256S",
          "type": "array"
        },
        "surface_text": {
          "minLength": 1,
          "title": "Surface Text",
          "type": "string"
        },
        "normalized_meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Meaning"
        },
        "dialect_expressions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DialectExpressionLabel"
          },
          "title": "Dialect Expressions",
          "type": "array"
        }
      },
      "required": [
        "utterance_id",
        "speaker_id",
        "split",
        "original_audio_sha256",
        "derived_audio_sha256",
        "derived_audio_path",
        "surface_text"
      ],
      "title": "BenchmarkEntry",
      "type": "object"
    },
    "DatasetSplit": {
      "enum": [
        "unassigned",
        "train",
        "validation",
        "test"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "DialectExpressionLabel": {
      "additionalProperties": false,
      "description": "A linguistic label; generated labels remain candidates until reviewed.",
      "properties": {
        "surface_form": {
          "minLength": 1,
          "title": "Surface Form",
          "type": "string"
        },
        "normalized_forms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Normalized Forms",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "candidate"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "surface_form"
      ],
      "title": "DialectExpressionLabel",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "human_reviewed",
        "approved",
        "deprecated"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "benchmark_id": {
      "minLength": 1,
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "minLength": 1,
      "title": "Benchmark Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "frozen": {
      "default": true,
      "title": "Frozen",
      "type": "boolean"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/BenchmarkEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "benchmark_id",
    "benchmark_version",
    "entries"
  ],
  "title": "BenchmarkManifest",
  "type": "object"
}
